#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

XFRPC_BIN="/usr/bin/xfrpc"
XFRPC_INI="/var/etc/xfrpc.ini"

uci_get_opt() {
	local section="$1"
	local option="$2"
	local default="${3:-}"
	local val
	val="$(uci get "xfrpc.${section}.${option}" 2>/dev/null)"
	echo "${val:-$default}"
}

gen_ini() {
	local output="$1"

	[ -d /var/etc ] || mkdir -p /var/etc

	{
		echo "[common]"
		echo "server_addr = $(uci_get_opt common server_addr '0.0.0.0')"
		echo "server_port = $(uci_get_opt common server_port '7000')"

		local token
		token="$(uci_get_opt common token '')"
		[ -n "$token" ] && echo "token = $token"

		local tcp_mux
		tcp_mux="$(uci_get_opt common tcp_mux '1')"
		[ -n "$tcp_mux" ] && echo "tcp_mux = $tcp_mux"

		local protocol
		protocol="$(uci_get_opt common protocol '')"
		[ -n "$protocol" ] && echo "protocol = $protocol"

		local wire_protocol
		wire_protocol="$(uci_get_opt common wire_protocol '')"
		[ -n "$wire_protocol" ] && echo "wire_protocol = $wire_protocol"

		local tls_enable
		tls_enable="$(uci_get_opt common tls_enable '')"
		[ -n "$tls_enable" ] && echo "tls_enable = $tls_enable"

		local user
		user="$(uci_get_opt common user '')"
		[ -n "$user" ] && echo "user = $user"

		local heartbeat_interval
		heartbeat_interval="$(uci_get_opt common heartbeat_interval '')"
		[ -n "$heartbeat_interval" ] && echo "heartbeat_interval = $heartbeat_interval"

		local heartbeat_timeout
		heartbeat_timeout="$(uci_get_opt common heartbeat_timeout '')"
		[ -n "$heartbeat_timeout" ] && echo "heartbeat_timeout = $heartbeat_timeout"

		echo ""
	} > "$output"

	local sections
	sections="$(uci show xfrpc 2>/dev/null | grep -oE '^xfrpc\.[^.=]+' | cut -d. -f2 | sort -u)"

	local section
	for section in $sections; do
		[ "$section" = "common" ] && continue

		local disabled
		disabled="$(uci_get_opt "$section" disabled '0')"
		[ "$disabled" = "1" ] && continue

		{
			echo "[$section]"

			local type local_ip local_port remote_port
			type="$(uci_get_opt "$section" type '')"
			local_ip="$(uci_get_opt "$section" local_ip '')"
			local_port="$(uci_get_opt "$section" local_port '')"
			remote_port="$(uci_get_opt "$section" remote_port '')"

			[ -n "$type" ] && echo "type = $type"
			[ -n "$local_ip" ] && echo "local_ip = $local_ip"
			[ -n "$local_port" ] && echo "local_port = $local_port"
			[ -n "$remote_port" ] && echo "remote_port = $remote_port"

			local custom_domains subdomain locations host_header_rewrite
			custom_domains="$(uci_get_opt "$section" custom_domains '')"
			subdomain="$(uci_get_opt "$section" subdomain '')"
			locations="$(uci_get_opt "$section" locations '')"
			host_header_rewrite="$(uci_get_opt "$section" host_header_rewrite '')"

			[ -n "$custom_domains" ] && echo "custom_domains = $custom_domains"
			[ -n "$subdomain" ] && echo "subdomain = $subdomain"
			[ -n "$locations" ] && echo "locations = $locations"
			[ -n "$host_header_rewrite" ] && echo "host_header_rewrite = $host_header_rewrite"

			local http_user http_pwd
			http_user="$(uci_get_opt "$section" http_user '')"
			http_pwd="$(uci_get_opt "$section" http_pwd '')"

			[ -n "$http_user" ] && echo "http_user = $http_user"
			[ -n "$http_pwd" ] && echo "http_pwd = $http_pwd"

			local use_encryption use_compression
			use_encryption="$(uci_get_opt "$section" use_encryption '')"
			use_compression="$(uci_get_opt "$section" use_compression '')"

			[ -n "$use_encryption" ] && echo "use_encryption = $use_encryption"
			[ -n "$use_compression" ] && echo "use_compression = $use_compression"

			local sk allow_users
			sk="$(uci_get_opt "$section" sk '')"
			allow_users="$(uci_get_opt "$section" allow_users '')"

			[ -n "$sk" ] && echo "sk = $sk"
			[ -n "$allow_users" ] && echo "allow_users = $allow_users"

			local multiplexer route_by_http_user
			multiplexer="$(uci_get_opt "$section" multiplexer '')"
			route_by_http_user="$(uci_get_opt "$section" route_by_http_user '')"

			[ -n "$multiplexer" ] && echo "multiplexer = $multiplexer"
			[ -n "$route_by_http_user" ] && echo "route_by_http_user = $route_by_http_user"

			echo ""
		} >> "$output"
	done
}

start_service() {
	[ -x "$XFRPC_BIN" ] || return 1

	local disabled
	disabled="$(uci_get_opt common disabled '0')"
	[ "$disabled" = "1" ] && return 1

	local loglevel
	loglevel="$(uci_get_opt common loglevel '7')"

	gen_ini "$XFRPC_INI"

	procd_open_instance
	procd_set_param command "$XFRPC_BIN" -c "$XFRPC_INI" -d "$loglevel"
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	killall xfrpc 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger "xfrpc"
}
